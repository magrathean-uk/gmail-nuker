#!/usr/bin/env python3
"""
gmail-block  --  Nuclear-level Gmail sender and domain blocker.

Brutally eradicates unwanted email senders and their entire root domains:
  1. Root-Level Incoming Filter: Intercepts all incoming messages from the target
     and its entire domain (and all subdomains). Routes them directly to TRASH
     (auto-expunged permanently), bypasses Inbox, marks as read, strips Important.
  2. Mailbox Purge: Scans mailbox for any existing messages from the target and
     purges them atomically via batchModify (or IMAP fallback).
  3. Phishing & Spam Flagging: Queries RDAP/WHOIS and MX records to identify the
     registrar abuse desk and hosting provider, generates Google SafeBrowsing
     reports, and can dispatch formal RFC 2142/RFC 5322 abuse complaints.
  4. One-Click Unsubscribe Strike: Automatically fires any List-Unsubscribe headers
     (RFC 8058 One-Click POST / mailto) found in previous messages before blocking.

Credentials:
  Uses service account secrets/service-account.json
  with domain-wide delegation for Google Workspace (default user: you@example.com).
  Can also use IMAP credentials from secrets/gmail-smtp.md for consumer accounts.
"""

from __future__ import annotations

import argparse
import base64
from collections.abc import Generator
from dataclasses import dataclass
from datetime import datetime, timezone
import email.message
import email.utils
import imaplib
import json
import os
from pathlib import Path
import re
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

# Optional high-performance in-memory RSA signing
try:
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import padding as asymmetric_padding
    HAVE_CRYPTOGRAPHY = True
except ImportError:
    HAVE_CRYPTOGRAPHY = False

# ── Paths and Defaults ────────────────────────────────────────────────────────

DEFAULT_SA_PATH = Path(
    os.environ.get(
        "GMAIL_BLOCK_SA",
        "secrets/service-account.json",
    )
)
DEFAULT_USER = os.environ.get("GMAIL_BLOCK_USER", "you@example.com")
SMTP_CREDS_PATH = Path(
    os.environ.get("GMAIL_SMTP_CREDS", "secrets/gmail-smtp.md")
)

GMAIL_API = "https://gmail.googleapis.com/gmail/v1"
TOKEN_URL = "https://oauth2.googleapis.com/token"

FULL_SCOPES = [
    "https://www.googleapis.com/auth/gmail.settings.basic",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/gmail.send",
]

BASE_SCOPES = [
    "https://www.googleapis.com/auth/gmail.settings.basic",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/gmail.send",
]

